<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Private Video</title>
<style>
:root{--bg:#f4f1ec;--fg:#1c1b1a;--card:#fff;--mut:#6f6a64;--ac:#1c1b1a;--err:#b3261e;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121110;--fg:#f1ede8;--card:#1d1b19;--mut:#9a948c;--ac:#f1ede8;--err:#f2b8b5}}
:root[data-theme="dark"]{--bg:#121110;--fg:#f1ede8;--card:#1d1b19;--mut:#9a948c;--ac:#f1ede8;--err:#f2b8b5}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100vh;background:var(--bg);color:var(--fg);font-family:Georgia,'Times New Roman',serif;display:flex;align-items:center;justify-content:center;padding:20px;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.card{background:var(--card);border-radius:20px;padding:32px 26px;width:100%;max-width:380px;box-shadow:0 10px 40px rgba(0,0,0,.12);text-align:center}
h1{font-size:22px;margin:8px 0 6px;font-weight:600}p{color:var(--mut);font-size:14px;margin:0 0 20px;font-family:system-ui,sans-serif}
input{width:100%;padding:14px;border-radius:12px;border:1.5px solid var(--mut);background:transparent;color:var(--fg);font-size:16px;text-align:center;outline:none;-webkit-user-select:text;user-select:text}
input:focus{border-color:var(--ac)}
button{margin-top:12px;width:100%;padding:14px;border:0;border-radius:12px;background:var(--ac);color:var(--bg);font-size:16px;font-weight:600;cursor:pointer}
button:disabled{opacity:.6}
#err{color:var(--err);font-size:13px;min-height:18px;margin-top:10px;font-family:system-ui,sans-serif}
.lock{font-size:34px}
#player{display:none;width:100%;max-width:420px;position:relative}
#wrap{position:relative;border-radius:16px;overflow:hidden;background:#000;transition:filter .15s}
#wrap.hide{filter:blur(40px) brightness(.2)}
video{display:block;width:100%;max-height:85vh;pointer-events:auto}
#wm{position:absolute;left:0;top:0;color:rgba(255,255,255,.28);font:600 13px system-ui,sans-serif;pointer-events:none;text-shadow:0 0 3px rgba(0,0,0,.5);white-space:nowrap;transition:all 4s linear}
#frame{position:relative;padding:30px;border-radius:22px;background:#0b0b0c;box-shadow:0 10px 40px rgba(0,0,0,.25)}
#ring{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#ring text{fill:#fff;font:700 13px system-ui,sans-serif;letter-spacing:3px}
#shield{position:absolute;inset:0;display:none;align-items:center;justify-content:center;color:#fff;font:600 15px system-ui,sans-serif;text-align:center;padding:20px;background:#000}
.note{margin-top:12px;font:12px system-ui,sans-serif;color:var(--mut);text-align:center}
@media print{body{display:none!important}}
</style></head>
<body oncontextmenu="return false">
<div class="card" id="gate">
  <div class="lock">🔒</div><h1>Private Video</h1><p>Enter the password to continue</p>
  <input id="pw" type="password" placeholder="Password" autocomplete="off" autofocus>
  <button id="go">Unlock</button><div id="err"></div>
</div>
<div id="player">
  <div id="frame"><svg id="ring" xmlns="http://www.w3.org/2000/svg"></svg><div id="wrap"><video id="v" playsinline controls controlsList="nodownload noremoteplayback noplaybackrate" disablePictureInPicture disableRemotePlayback></video><div id="wm"></div><div id="shield">Content hidden while the page is not in focus</div></div>
  </div><div class="note">Protected content · do not share</div>
</div>
<script>
const SALT="SI0rN3ZnUVlyMMTH+ViuKg==",IV="nGzBoTNMUJXdvxTd",DATA="";
const d=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
const $=id=>document.getElementById(id);
async function unlock(){
  const pw=$('pw').value;if(!pw)return;
  $('go').disabled=true;$('err').textContent='';
  try{
    const km=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveKey']);
    const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:d(SALT),iterations:150000,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['decrypt']);
    const buf=await crypto.subtle.decrypt({name:'AES-GCM',iv:d(IV)},key,d(DATA));
    const url=URL.createObjectURL(new Blob([buf],{type:'video/mp4'}));
    $('gate').style.display='none';$('player').style.display='block';
    const v=$('v');v.src=url;v.play().catch(()=>{});
    startGuards();
  }catch(e){$('err').textContent='Wrong password. Try again.';$('go').disabled=false;$('pw').select();}
}
$('go').onclick=unlock;$('pw').addEventListener('keydown',e=>{if(e.key==='Enter')unlock()});
function buildRing(){
  const f=$('frame'),svg=$('ring'),W=f.clientWidth,H=f.clientHeight,i=15,r=14;
  svg.setAttribute('viewBox','0 0 '+W+' '+H);
  const x=i,y=i,w=W-2*i,h=H-2*i;
  const p='M'+(x+r)+','+y+' H'+(x+w-r)+' A'+r+','+r+' 0 0 1 '+(x+w)+','+(y+r)+' V'+(y+h-r)+' A'+r+','+r+' 0 0 1 '+(x+w-r)+','+(y+h)+' H'+(x+r)+' A'+r+','+r+' 0 0 1 '+x+','+(y+h-r)+' V'+(y+r)+' A'+r+','+r+' 0 0 1 '+(x+r)+','+y+' Z';
  svg.innerHTML='<defs><path id="rp" d="'+p+'"/></defs><text dy="4.5"><textPath id="tp" href="#rp">'+'PRIVATE VIDEO  \u2022  '.repeat(40)+'</textPath></text>';
}
let off=0;(function spin(){const tp=document.getElementById('tp');if(tp){const per=(tp.getComputedTextLength()||16000)/40;off=(off-0.6)%per;tp.setAttribute('startOffset',off)}requestAnimationFrame(spin)})();
function startGuards(){buildRing();addEventListener('resize',buildRing);
  const wrap=$('wrap'),v=$('v'),sh=$('shield'),wm=$('wm');
  const hide=()=>{wrap.classList.add('hide');sh.style.display='flex';v.pause()};
  const show=()=>{wrap.classList.remove('hide');sh.style.display='none'};
  document.addEventListener('visibilitychange',()=>document.hidden?hide():show());
  window.addEventListener('blur',hide);window.addEventListener('focus',show);
  document.addEventListener('keyup',e=>{if(e.key==='PrintScreen'){try{navigator.clipboard.writeText('')}catch(_){}hide();setTimeout(show,2500)}});
  document.addEventListener('keydown',e=>{
    const k=e.key.toLowerCase();
    if(e.key==='PrintScreen'||(e.ctrlKey||e.metaKey)&&['s','p','u'].includes(k)||(e.metaKey&&e.shiftKey&&['3','4','5'].includes(k))||e.key==='F12'||(e.ctrlKey&&e.shiftKey&&['i','j','c'].includes(k))){e.preventDefault();hide();setTimeout(show,1500)}
  });
  ['contextmenu','dragstart','copy','cut'].forEach(t=>document.addEventListener(t,e=>e.preventDefault()));
  // moving watermark
  const tag='Protected · '+new Date().toLocaleString();wm.textContent=tag;
  const move=()=>{const w=wrap.clientWidth-wm.offsetWidth,h=wrap.clientHeight-wm.offsetHeight;wm.style.left=Math.random()*Math.max(w,0)+'px';wm.style.top=Math.random()*Math.max(h,0)+'px'};
  move();setInterval(move,4000);
}
</script>
</body></html>
